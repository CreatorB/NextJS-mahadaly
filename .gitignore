# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/deploy
deploy.zip
/uploads

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Test logs
dev_out.log
dev_err.log
test_login_*.png

# Server logs
logs/

# ===========================================
# SECURITY: Local-only files (NEVER commit)
# ===========================================
# Helper scripts with hardcoded creds must live in work/ only.
# See AGENTS.md section "Security Rules - No Passwords in Git"
/scripts
/reset-password.*
/aggressive_fix.ps1
/fix_and_test.ps1
/quickstart.ps1
/test-login.mjs
/test_login_localhost.mjs
/test_*.mjs
/login_*.mjs
